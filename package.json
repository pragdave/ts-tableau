{
  "name": "ts-tableau",
  "version": "1.0.0",
  "description": "A library that simplifies table layout by separating data from layout, for use as a preprocessor for Markdown and similar markup languages.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tableau.css": "./dist/tableau.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && cp assets/tableau.css dist/tableau.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "tab": "tsx cli/tab.ts",
    "md2html": "tsx cli/md2html.mts",
    "test": "jest",
    "wtest": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "jest": "^29.7.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "remark-tableau": "file:../remark-tableau",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.5",
    "typescript": "^5.6.2",
    "unified": "^11.0.5"
  },
  "dependencies": {
    "strscan-ts": "^1.0.0"
  }
}
