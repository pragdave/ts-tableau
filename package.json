{
  "name": "ts-tableau",
  "version": "0.2.0",
  "description": "A library that simplifies table layout by separating data from layout, for use as a preprocessor for Markdown and similar markup languages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pragdave/ts-tableau.git"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tableau.css": "./dist/tableau.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && cp assets/tableau.css dist/tableau.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "tab": "tsx cli/tab.ts",
    "md2html": "tsx cli/md2html.mts",
    "build:site": "tsx cli/build-site.mts",
    "test": "jest",
    "wtest": "jest --watch",
    "playground:build": "vite build --config playground/vite.config.ts",
    "playground": "node playground/serve.mjs"
  },
  "keywords": [
    "markdown",
    "table",
    "tables",
    "html",
    "remark",
    "unified",
    "preprocessor",
    "table-layout",
    "quarto",
    "pandoc",
    "typescript"
  ],
  "author": "Dave Thomas (pragdave)",
  "license": "ISC",
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/jest": "^29.5.13",
    "@types/mdast": "^4.0.4",
    "glob": "^13.0.6",
    "hast-util-to-string": "^3.0.1",
    "jest": "^29.7.0",
    "katex": "^0.18.4",
    "mdast-util-to-string": "^4.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "remark-tableau": "file:../remark-tableau",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.5",
    "typescript": "^5.6.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "strscan-ts": "^1.0.0"
  }
}
